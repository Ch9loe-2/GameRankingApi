@GameRankingApi_HostAddress = http://localhost:5194

### 验证修改后的成绩
GET {{GameRankingApi_HostAddress}}/api/score/1
Accept: application/json

### 删除玩家成绩
DELETE {{GameRankingApi_HostAddress}}/api/score/2

###
GET http://localhost:5194/api/score/2
Accept: application/json

### 测试非法成绩
POST {{GameRankingApi_HostAddress}}/api/score
Content-Type: application/json

{
    "playerName": "",
    "score": -100,
    "gameName": ""
}

### 测试负数分数
POST {{GameRankingApi_HostAddress}}/api/score
Content-Type: application/json

{
    "playerName": "测试玩家",
    "score": -100,
    "gameName": "测试游戏"
}

### 测试正常成绩
POST {{GameRankingApi_HostAddress}}/api/score
Content-Type: application/json

{
    "playerName": "测试玩家",
    "score": 3000,
    "gameName": "测试游戏"
}

### 获取排行榜
GET {{GameRankingApi_HostAddress}}/api/score
Accept: application/json

### 修改不存在的成绩
PUT {{GameRankingApi_HostAddress}}/api/score/999
Content-Type: application/json

{
    "playerName": "不存在的人",
    "score": 9999,
    "gameName": "不存在的游戏"
}

### 修改时提交非法数据
PUT {{GameRankingApi_HostAddress}}/api/score/1
Content-Type: application/json

{
    "playerName": "",
    "score": -100,
    "gameName": ""
}